# PostgreSQL connection string used by both the app (src/db/index.ts)
# and drizzle-kit (drizzle.config.ts).
#
# Local example:
#   postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production example (Neon / Vercel Postgres):
#   postgresql://USER:PASSWORD@HOST.pooler.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=
